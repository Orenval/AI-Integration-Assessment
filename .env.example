# =============================================================================
# AI Integration (Assessment 3) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values. Never commit a real .env file.

# ---- Database ----------------------------------------------------------------
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/ai_integration_assessment?schema=public"

# ---- SMTP (Nodemailer) ------------------------------------------------------
# For local development, use Ethereal (https://ethereal.email) or Mailtrap.
SMTP_HOST="smtp.nodemailer.email"
SMTP_PORT="587"
SMTP_USER="your-nodemailer-user@ethereal.email"
SMTP_PASS="your-nodemailer-password"
SMTP_FROM="AI Assessment <noreply@aiassessment.local>"

# ---- Security Secrets --------------------------------------------------------
# SESSION_SECRET: Used to derive HMAC keys for hashing session tokens before storage.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-hex-char-random-string"

# CSRF_SECRET: Used for CSRF token generation via HMAC.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET="replace-with-64-hex-char-random-string"

# ---- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Gemini API (Role 1 & Role 2) --------------------------------------------
GEMINI_API_KEY=

# ---- Cloudflare R2 (Object Storage) -----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
